# Mau cau hinh cho backend. Sao chep thanh `.env` tren may local va dien gia tri that.
# KHONG commit `.env` thuc.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# SESSION_SECRET se duoc sinh bang node:crypto khi agent tao .env local.
SESSION_SECRET=

# Mat khau demo cho tai khoan seed. Bo trong -> seed tu sinh bang node:crypto.
# Chi doc tren may local (khong commit gia tri that).
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_PASSWORD=