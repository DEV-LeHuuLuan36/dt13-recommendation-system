{
  "name": "@dt13/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express backend cho DT13 Recommendation System (Giai doan 1: health va kiem tra Neo4j)",
  "main": "src/server.js",
