52","eventId":"RC_V0351","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-30T09:00:00Z"},{"customerId":"RC_C004","productId":"RC_P069","eventId":"RC_V0352","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-27T09:00:00Z"},{"customerId":"RC_C005","productId":"RC_P086","eventId":"RC_V0353","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-28T09:00:00Z"},{"customerId":"RC_C006","productId":"RC_P103","eventId":"RC_V0354","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-29T09:00:00Z"},{"customerId":"RC_C007","productId":"RC_P120","eventId":"RC_V0355","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-30T09:00:00Z"},{"customerId":"RC_C008","productId":"RC_P017","eventId":"RC_V0356","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-27T09:00:00Z"},{"customerId":"RC_C009","productId":"RC_P034","eventId":"RC_V0357","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-28T09:00:00Z"},{"customerId":"RC_C010","productId":"RC_P051","eventId":"RC_V0358","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-29T09:00:00Z"},{"customerId":"RC_C011","productId":"RC_P068","eventId":"RC_V0359","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-30T09:00:00Z"},{"customerId":"RC_C012","productId":"RC_P085","eventId":"RC_V0360","datasetTag":"CATALOG_REAL_120_V1","viewedAt":"2026-09-27T09:00:00Z"},{"customerId":"RC_C004","productId":"RC_P014","eventId":"VIEWED_mvoujcx8_38_guzkfx","viewedAt":"2026-10-26T05:59:02.748000000Z"},{"customerId":"RC_C004","productId":"RC_P093","eventId":"VIEWED_mvoujiqz_45_gk1ta0","viewedAt":"2026-10-26T05:59:10.037000000Z"},{"customerId":"RC_C001","productId":"RC_P014","eventId":"VIEWED_mvoujy4j_56_lvppwb","viewedAt":"2026-10-26T05:59:29.950000000Z"}] AS row
MATCH (c:Customer { customerId: row.customerId })
MATCH (p:Product { productId: row.productId })
MERGE (c)-[r:VIEWED { eventId: row.eventId }]->(p)
SET r.datasetTag = row.datasetTag,
    r.durationSeconds = row.durationSeconds,
    r.viewedAt = CASE WHEN row.viewedAt IS NOT NULL THEN datetime(row.viewedAt) ELSE datetime() END;

// --- 8. XAC MINH SO LUONG THUC THE VA QUAN HE ---
CALL { MATCH (c:Category) RETURN count(c) AS categories }
CALL { MATCH (p:Product) RETURN count(p) AS products }
CALL { MATCH (c:Customer) RETURN count(c) AS customers }
CALL { MATCH ()-[r:BELONGS_TO]->() RETURN count(r) AS belongsTo }
CALL { MATCH ()-[r:BOUGHT]->() RETURN count(r) AS bought }
CALL { MATCH ()-[r:VIEWED]->() RETURN count(r) AS viewed }
RETURN categories, products, customers, belongsTo, bought, viewed;
