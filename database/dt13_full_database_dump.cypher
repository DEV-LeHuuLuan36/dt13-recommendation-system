MATCH (c:Customer { customerId: row.customerId })
MATCH (p:Product { productId: row.productId })
MERGE (c)-[r:BOUGHT { eventId: row.eventId }]->(p)
SET r.unitPrice = row.unitPrice,
    r.quantity = row.quantity,
    r.datasetTag = row.datasetTag,
    r.purchasedAt = CASE WHEN row.purchasedAt IS NOT NULL THEN datetime(row.purchasedAt) ELSE datetime() END;

