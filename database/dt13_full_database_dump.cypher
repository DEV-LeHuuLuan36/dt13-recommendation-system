SET c.name = row.name,
    c.email = row.email,
    c.role = row.role,
    c.cohort = row.cohort,
    c.active = row.active,
    c.passwordHash = row.passwordHash,
    c.datasetTag = row.datasetTag,
    c.referenceCatalogTags = row.referenceCatalogTags,
    c.createdAt = CASE WHEN row.createdAt IS NOT NULL THEN datetime(row.createdAt) ELSE datetime() END,
    c.updatedAt = CASE WHEN row.updatedAt IS NOT NULL THEN datetime(row.updatedAt) ELSE null END;

