// --- 1. RANG BUOC TOAN VEN DUY NHAT (CONSTRAINTS) ---
CREATE CONSTRAINT category_categoryId_unique IF NOT EXISTS FOR (c:Category) REQUIRE c.categoryId IS UNIQUE;
CREATE CONSTRAINT product_productId_unique IF NOT EXISTS FOR (p:Product) REQUIRE p.productId IS UNIQUE;
CREATE CONSTRAINT customer_customerId_unique IF NOT EXISTS FOR (c:Customer) REQUIRE c.customerId IS UNIQUE;
CREATE CONSTRAINT customer_email_unique IF NOT EXISTS FOR (c:Customer) REQUIRE c.email IS UNIQUE;
CREATE CONSTRAINT bought_eventId_unique IF NOT EXISTS FOR ()-[r:BOUGHT]-() REQUIRE r.eventId IS UNIQUE;
CREATE CONSTRAINT viewed_eventId_unique IF NOT EXISTS FOR ()-[r:VIEWED]-() REQUIRE r.eventId IS UNIQUE;

// --- 2. KHOI TAO DANH MUC (CATEGORIES) ---
UNWIND [{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Tai nghe","categoryId":"RC_CAT_HEADPHONES","slug":"headphones","updatedAt":"2026-10-14T20:35:20.513000000Z"},{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Bàn phím","categoryId":"RC_CAT_KEYBOARD","slug":"keyboard","updatedAt":"2026-10-14T20:35:20.509000000Z"},{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Laptop","categoryId":"RC_CAT_LAPTOP","slug":"laptop","updatedAt":"2026-10-14T20:35:20.399000000Z"},{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Chuột","categoryId":"RC_CAT_MOUSE","slug":"mouse","updatedAt":"2026-10-14T20:35:20.512000000Z"},{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Điện thoại","categoryId":"RC_CAT_SMARTPHONE","slug":"smartphone","updatedAt":"2026-10-14T20:35:20.437000000Z"},{"referenceCatalogTags":["CATALOG_REAL_120_V1"],"datasetTag":"CATALOG_REAL_120_V1","name":"Máy tính bảng","categoryId":"RC_CAT_TABLET","slug":"tablet","updatedAt":"2026-10-14T20:35:20.476000000Z"}] AS row
MERGE (c:Category { categoryId: row.categoryId })
SET c.name = row.name,
    c.slug = row.slug,
    c.datasetTag = row.datasetTag,
    c.referenceCatalogTags = row.referenceCatalogTags,
    c.updatedAt = CASE WHEN row.updatedAt IS NOT NULL THEN datetime(row.updatedAt) ELSE datetime() END;

