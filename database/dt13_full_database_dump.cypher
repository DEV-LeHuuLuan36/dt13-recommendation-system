MERGE (p:Product { productId: row.productId })
SET p.name = row.name,
    p.slug = row.slug,
    p.brand = row.brand,
    p.model = row.model,
    p.price = row.price,
    p.currency = row.currency,
    p.description = row.description,
    p.imageUrl = row.imageUrl,
    p.searchText = row.searchText,
    p.catalogKey = row.catalogKey,
    p.sourceUrl = row.sourceUrl,
    p.active = row.active,
    p.illustrationKey = row.illustrationKey,
    p.imageKind = row.imageKind,
    p.datasetTag = row.datasetTag,
    p.referenceCatalogTags = row.referenceCatalogTags,
    p.createdAt = CASE WHEN row.createdAt IS NOT NULL THEN datetime(row.createdAt) ELSE datetime() END;

